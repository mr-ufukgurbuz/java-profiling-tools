# ---------------------------------------------------------------------------
# CAREFUL: the bundled tool archives (*.zip, *.z01, *.tar.gz, *.tgz, *.jar,
# *.nbm) ARE the point of this repository - they are what makes it work with
# no internet. So the usual Java .gitignore, which ignores every archive, must
# NOT be used here. Only build output and local state are ignored below.
# ---------------------------------------------------------------------------

# Unpacked tools: produced by scripts/00-setup.sh from the archives in this repo.
tools/

# Everything the scripts write at run time goes to $PERF_OUT (default
# $HOME/perf-out), never into the repository - but ignore it anyway in case
# someone points PERF_OUT here.
perf-out/

# Build output
*.class
target/
build/
out/

# JVM crash logs
hs_err_pid*
replay_pid*

# Python
__pycache__/
*.pyc

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store
